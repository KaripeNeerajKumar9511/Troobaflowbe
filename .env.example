# Copy to backend/.env on the server (never commit .env with real secrets).
# Format: KEY=value  (NOT PowerShell $env: syntax)

# --- Production (gotrooba.ai) ---
DEBUG=0
# LIVE_SITE=1 required on GCP/production (HTTPS). Use LIVE_SITE=0 for local http://127.0.0.1:8080 dev.
LIVE_SITE=1
USE_INMEMORY_CHANNEL_LAYER=0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT=30
REDIS_CONNECT_TIMEOUT=10

ALLOWED_HOSTS=localhost,127.0.0.1,34.14.184.16,gotrooba.ai,www.gotrooba.ai,app.gotrooba.ai
SESSION_COOKIE_DOMAIN=.gotrooba.ai

# Invite emails always use this URL (not localhost). Local dev: http://127.0.0.1:8080
PUBLIC_APP_URL=https://app.gotrooba.ai

# Database (production server)
DB_NAME=RMCTtrooba
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# TF Admin portal
TF_ADMIN_EMAIL=admin@gmail.com
TF_ADMIN_PASSWORD=Admin@123

# SMTP (member invites + org welcome emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=support@gosplash.ai
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=support@gosplash.ai
EMAIL_HOST_PASSWORD=your-smtp-password-here
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Optional extra origins (defaults already include https://gotrooba.ai etc.)
# CORS_ALLOWED_ORIGINS=https://rmctapi.gotrooba.ai
# CSRF_TRUSTED_ORIGINS=https://rmctapi.gotrooba.ai
